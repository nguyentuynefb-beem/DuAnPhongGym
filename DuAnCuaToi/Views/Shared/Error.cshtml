@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi Hệ Thống";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card bg-surface border-slate-700 shadow-2xl rounded-4 text-center p-4 p-md-5">
                <div class="mb-3 text-warning">
                    <i class="bi bi-exclamation-triangle-fill display-1"></i>
                </div>

                <h2 class="fw-bold text-white mb-2">Đã Xảy Ra Lỗi!</h2>
                <p class="text-slate-400 mb-4">
                    Hệ thống không thể xử lý yêu cầu của bạn vào lúc này. Vui lòng thử lại sau hoặc liên hệ với quản trị viên.
                </p>

                @if (Model != null && Model.ShowRequestId)
                {
                    <div class="bg-dark p-3 rounded-3 border border-slate-800 text-start mb-4">
                        <small class="text-slate-400 d-block font-monospace">
                            <strong>Mã Yêu Cầu (Request ID):</strong> <code class="text-warning">@Model.RequestId</code>
                        </small>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary text-light border-slate-700 px-4 py-2 rounded-3">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-warning px-4 py-2 fw-bold rounded-3 shadow-warning">
                        <i class="bi bi-house-door me-1"></i> Trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>