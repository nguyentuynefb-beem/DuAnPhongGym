@{
    ViewData["Title"] = "Điểm danh hội viên";
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-xl mx-auto my-10 px-4 font-sans">

    <h1 class="text-xl sm:text-2xl font-black text-amber-400 uppercase tracking-wide flex items-center gap-3 mb-6">
        <i class="fa-solid fa-camera"></i>
        Điểm Danh Hội Viên
    </h1>

    <div class="bg-[#1e232a] border border-slate-800 rounded-2xl shadow-2xl p-6 space-y-4">

        <h2 class="text-sm font-bold text-white uppercase tracking-wide flex items-center gap-2">
            <i class="fa-solid fa-qrcode text-amber-400"></i>
            Camera quét QR
        </h2>

        <div id="reader" class="w-full rounded-xl overflow-hidden border border-slate-800"></div>

        <div class="bg-[#161a20] border border-slate-800 rounded-xl p-4 flex items-center gap-2">
            <span class="text-slate-400 text-xs uppercase font-semibold">Mã hội viên:</span>
            <span id="ketQua" class="text-white font-bold">Chưa quét</span>
        </div>

    </div>

</div>

<script src="https://unpkg.com/html5-qrcode"></script>
<script>

    const html5QrCode = new Html5Qrcode("reader");

    Html5Qrcode.getCameras().then(devices => {

        if (devices && devices.length) {

            html5QrCode.start(

                devices[0].id,

                {
                    fps: 10,
                    qrbox: 250
                },

                (decodedText) => {

                    document.getElementById("ketQua").innerHTML = decodedText;

                    fetch("/Reception/CheckInQR", {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded"
                        },

                        body: "maHoiVien=" + encodeURIComponent(decodedText)

                    })

                        .then(response => response.json())

                        .then(data => {

                            alert(data.message);

                        });

                }

            );

        }

    });

</script>