@model DuAnCuaToi.Models.HoaDon
@{
    ViewData["Title"] = "Thanh toán QR";
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-md mx-auto my-10 px-4 font-sans">
    <div class="bg-[#1e232a] border border-slate-800 rounded-2xl shadow-2xl p-6 sm:p-8 text-center space-y-5">

        <h1 class="text-lg font-bold text-amber-400 uppercase tracking-wide flex items-center justify-center gap-2">
            <i class="fa-solid fa-qrcode"></i>
            Thanh Toán QR
        </h1>

        <div class="bg-white rounded-2xl p-4 inline-block">
            <img src="data:image/png;base64,@ViewBag.QRCode" width="260" class="mx-auto rounded-lg" />
        </div>

        <div>
            <p class="text-slate-400 text-xs uppercase tracking-wide">Số tiền cần thanh toán</p>
            <h2 class="text-2xl font-black text-emerald-400 mt-1">@Model.TongTien.ToString("N0") VNĐ</h2>
        </div>

        <a asp-action="XacNhanThanhToan" asp-route-id="@Model.Id"
           class="inline-flex items-center justify-center gap-2 w-full bg-emerald-500 hover:bg-emerald-400 text-white font-bold py-3 rounded-xl transition">
            <i class="fa-solid fa-circle-check"></i>
            Đã thanh toán
        </a>

    </div>
</div>