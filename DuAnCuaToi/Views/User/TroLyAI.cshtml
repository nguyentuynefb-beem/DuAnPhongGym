<script>

    // =========================================================
    // LẤY CSRF TOKEN
    // =========================================================

    function getCsrfToken() {

        const token =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

        return token
            ? token.value
            : '';

    }


    // Đọc response AI an toàn: ASP.NET có thể trả HTML/text khi lỗi CSRF/500.
    async function readAIJsonResponse(response, fallbackMessage) {
        const raw = await response.text();
        let data;

        try {
            data = JSON.parse(raw);
        }
        catch {
            const safeText =
                raw && !raw.trim().startsWith('<')
                    ? raw.trim().slice(0, 400)
                    : '';

            throw new Error(
                safeText || `${fallbackMessage} (HTTP ${response.status})`
            );
        }

        if (!response.ok || !data?.success) {
            throw new Error(
                data?.message || `${fallbackMessage} (HTTP ${response.status})`
            );
        }

        return data;
    }


    // =========================================================
    // HIỂN THỊ LỖI
    // =========================================================

    function showError(message) {

        alert(message);

    }


    // =========================================================
    // FR8
    // =========================================================

    async function tomTatInBody() {

        const button =
            document.getElementById(
                'btnInBody'
            );

        const loading =
            document.getElementById(
                'inBodyLoading'
            );

        const result =
            document.getElementById(
                'inBodyResult'
            );

        const text =
            document.getElementById(
                'inBodyText'
            );

        button.disabled = true;

        loading.classList.remove(
            'hidden'
        );

        result.classList.add(
            'hidden'
        );

        try {

            const response =
                await fetch(
                    '@Url.Action("AiTomTatInBody", "User")',
                    {
                        method: 'POST',

                        headers: {
                            'RequestVerificationToken':
                                getCsrfToken()
                        }
                    }
                );

            const data =
                await readAIJsonResponse(
                    response,
                    'Không thể gọi AI.'
                );

            text.textContent =
                data.data;

            result.classList.remove(
                'hidden'
            );

        }
        catch (error) {

            showError(
                error.message
            );

        }
        finally {

            button.disabled = false;

            loading.classList.add(
                'hidden'
            );

        }

    }


    // =========================================================
    // FR9
    // =========================================================

    async function sinhLich() {

        const button =
            document.getElementById(
                'btnSchedule'
            );

        const loading =
            document.getElementById(
                'scheduleLoading'
            );

        const result =
            document.getElementById(
                'scheduleResult'
            );

        const text =
            document.getElementById(
                'scheduleText'
            );

        const goal =
            document.getElementById(
                'aiGoal'
            ).value;

        const availability =
            document.getElementById(
                'aiTime'
            ).value;

        const level =
            document.getElementById(
                'aiLevel'
            ).value;

        button.disabled = true;

        loading.classList.remove(
            'hidden'
        );

        result.classList.add(
            'hidden'
        );

        try {

            const response =
                await fetch(
                    '@Url.Action("AiSinhLich", "User")',
                    {
                        method: 'POST',

                        headers: {
                            'Content-Type':
                                'application/json',

                            'RequestVerificationToken':
                                getCsrfToken()
                        },

                        body: JSON.stringify({
                            goal: goal,
                            availability: availability,
                            level: level
                        })
                    }
                );

            const data =
                await readAIJsonResponse(
                    response,
                    'Không thể tạo lịch AI.'
                );

            text.textContent =
                data.data;

            result.classList.remove(
                'hidden'
            );

        }
        catch (error) {

            showError(
                error.message
            );

        }
        finally {

            button.disabled = false;

            loading.classList.add(
                'hidden'
            );

        }

    }


    // =========================================================
    // FR10
    // =========================================================

            async function sendChat() {

            const input =
                document.getElementById('chatQuestion');

            const button =
                document.getElementById('btnChat');

            const question =
                input.value.trim();

            if (!question) {
                return;
            }


            // =====================================================
            // HIỂN THỊ CÂU HỎI NGƯỜI DÙNG
            // =====================================================
            addChatMessage(
                question,
                true
            );


            input.value = '';

            button.disabled = true;


            // =====================================================
            // LOADING
            // =====================================================
            const loadingId =
                'ai-loading-' + Date.now();

            addLoadingMessage(
                loadingId
            );


            try {

                // =================================================
                // CHỈ GỬI 6 TIN NHẮN GẦN NHẤT
                // =================================================
                const history =
                    aiConversationHistory
                        .slice(-4);


                const response =
                    await fetch(
                        '@Url.Action("AiChat", "User")',
                        {
                            method: 'POST',

                            headers: {
                                'Content-Type':
                                    'application/json',

                                'RequestVerificationToken':
                                    getCsrfToken()
                            },

                            body: JSON.stringify({
                                question: question,

                                history: history
                            })
                        }
                    );


                // =================================================
                // KHÔNG GỌI response.json() TRỰC TIẾP
                //
                // Vì nếu server trả HTML/error text,
                // response.json() sẽ gây:
                //
                // Unexpected end of JSON input
                // =================================================
                const responseText =
                    await response.text();


                let data;


                try {

                    data =
                        JSON.parse(responseText);

                }
                catch {

                    throw new Error(
                        responseText ||
                        `Server không trả JSON. HTTP ${response.status}`
                    );

                }


                removeLoadingMessage(
                    loadingId
                );


                if (!response.ok ||
                    !data.success) {

                    throw new Error(
                        data.message ||
                        'AI không thể trả lời.'
                    );

                }


                const aiAnswer =
                    data.data || '';


                // =================================================
                // HIỂN THỊ AI
                // =================================================
                addChatMessage(
                    aiAnswer,
                    false
                );


                // =================================================
                // LƯU LỊCH SỬ NHẸ
                //
                // Không lưu vô hạn.
                // Chỉ giữ tối đa 8 tin ở trình duyệt.
                // =================================================
                aiConversationHistory.push({
                    role: 'user',
                    content: question
                });


                aiConversationHistory.push({
                    role: 'assistant',
                    content: aiAnswer
                });


                while (
                    aiConversationHistory.length > 6
                ) {

                    aiConversationHistory.shift();

                }

            }
            catch (error) {

                removeLoadingMessage(
                    loadingId
                );


                addChatMessage(
                    error.message ||
                    'Không thể kết nối tới AI.',
                    false
                );

            }
            finally {

                button.disabled = false;

                input.focus();

            }
        }


    // =========================================================
    // QUICK ACTION CHIPS & SAO CHÉP TIN NHẮN
    // =========================================================

    const defaultQuickChips = [
        '🥗 Gợi ý thực đơn sau tập',
        '🎫 Hạn gói tập của tôi',
        '🕒 Giờ mở cửa SmartGym',
        '🏋️‍♂️ Lịch trống HLV'
    ];

    function renderQuickChips(chips) {
        const container =
            document.getElementById('quickChipsContainer');
        if (!container) return;

        container.innerHTML = '';
        (chips || defaultQuickChips).forEach(chipText => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className =
                'group inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-900/90 border border-slate-700/80 text-slate-300 hover:text-white hover:border-violet-500 hover:bg-violet-600/20 active:scale-95 transition-all duration-150 cursor-pointer';
            btn.textContent = chipText;
            btn.onclick = () => selectQuickChip(chipText);
            container.appendChild(btn);
        });
    }

    function selectQuickChip(chipText) {
        const input =
            document.getElementById('chatQuestion');
        if (!input) return;

        input.value = chipText;
        sendChat();
    }

    function resetDefaultChips() {
        renderQuickChips(defaultQuickChips);
    }

    function updateContextualChips(aiAnswer) {
        if (!aiAnswer || typeof aiAnswer !== 'string') {
            return;
        }

        const lower = aiAnswer.toLowerCase();

        if (lower.includes('thực đơn') || lower.includes('dinh dưỡng') || lower.includes('protein') || lower.includes('calo') || lower.includes('bữa ăn') || lower.includes('ăn uống')) {
            renderQuickChips([
                '💧 Lượng nước nên uống mỗi ngày?',
                '🍗 Thực phẩm giàu protein dễ tìm?',
                '⏰ Nên ăn trước hay sau tập?',
                '🥗 Gợi ý thực đơn giảm mỡ'
            ]);
        }
        else if (lower.includes('gói tập') || lower.includes('hạn') || lower.includes('hết hạn') || lower.includes('gia hạn') || lower.includes('thẻ hội viên')) {
            renderQuickChips([
                '💳 Cách gia hạn gói tập?',
                '🎁 Có chương trình ưu đãi nào không?',
                '📋 Tiện ích đi kèm gói tập của tôi?',
                '🎫 Hạn gói tập của tôi'
            ]);
        }
        else if (lower.includes('inbody') || lower.includes('mỡ') || lower.includes('cơ bắp') || lower.includes('cân nặng') || lower.includes('chỉ số')) {
            renderQuickChips([
                '📉 Làm sao để giảm mỡ hiệu quả?',
                '📈 Cách tăng cơ an toàn cho người mới?',
                '📅 Bao lâu nên đo InBody lại?',
                '🥗 Gợi ý thực đơn sau tập'
            ]);
        }
        else if (lower.includes('lịch') || lower.includes('hlv') || lower.includes('huấn luyện viên') || lower.includes('buổi tập') || lower.includes('bài tập')) {
            renderQuickChips([
                '💪 Bài tập ngực và tay hiệu quả?',
                '🩹 Cách giảm đau mỏi cơ sau tập?',
                '🕒 Giờ mở cửa phòng tập?',
                '🏋️‍♂️ Lịch trống HLV'
            ]);
        }
        else {
            renderQuickChips(defaultQuickChips);
        }
    }

    async function copyChatMessage(button) {
        if (!button) return;
        const container =
            button.closest('.relative') || button.parentElement;
        const textElement =
            container ? container.querySelector('p') : null;
        const textToCopy =
            textElement ? textElement.textContent.trim() : '';

        if (!textToCopy) return;

        try {
            if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(textToCopy);
            } else {
                const textArea = document.createElement('textarea');
                textArea.value = textToCopy;
                textArea.style.position = 'fixed';
                textArea.style.left = '-9999px';
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                document.execCommand('copy');
                textArea.remove();
            }

            const icon = button.querySelector('i');
            if (icon) {
                icon.className = 'fa-solid fa-check text-emerald-400';
                setTimeout(() => {
                    icon.className = 'fa-regular fa-copy';
                }, 2000);
            }
        } catch (err) {
            console.error('Không thể sao chép văn bản:', err);
        }
    }


    function addChatMessage(
        message,
        isUser
    ) {

        const chatBox =
            document.getElementById(
                'chatBox'
            );

        const wrapper =
            document.createElement(
                'div'
            );

        wrapper.className =
            isUser
                ? 'flex justify-end'
                : 'flex justify-start';

        const bubble =
            document.createElement(
                'div'
            );

        bubble.className =
            isUser
                ? 'max-w-[90%] rounded-xl bg-orange-500/10 border border-orange-500/20 p-3'
                : 'relative group max-w-[90%] rounded-xl bg-violet-500/10 border border-violet-500/20 p-3';

        if (isUser) {
            bubble.innerHTML =
                `
                <p class="text-sm text-orange-300 whitespace-pre-line leading-7"></p>
                `;
            bubble.querySelector('p').textContent = message;
        } else {
            bubble.innerHTML =
                `
                <div class="flex items-start justify-between gap-2">
                    <p class="text-sm text-violet-300 whitespace-pre-line leading-7 flex-1"></p>
                    <button type="button"
                            onclick="copyChatMessage(this)"
                            class="shrink-0 p-1 rounded-md text-slate-400 hover:text-white hover:bg-violet-500/20 transition text-xs"
                            title="Sao chép nội dung">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>
                `;
            bubble.querySelector('p').textContent = message;

            // Tự động phân tích câu trả lời để cập nhật chip gợi ý thông minh
            updateContextualChips(message);
        }

        wrapper.appendChild(
            bubble
        );

        chatBox.appendChild(
            wrapper
        );

        chatBox.scrollTop =
            chatBox.scrollHeight;

    }


    function addLoadingMessage(
        id
    ) {

        const chatBox =
            document.getElementById(
                'chatBox'
            );

        const wrapper =
            document.createElement(
                'div'
            );

        wrapper.id = id;

        wrapper.className =
            'flex justify-start';

        wrapper.innerHTML =
            `
            <div class="rounded-xl
                        bg-slate-800
                        p-3
                        text-xs
                        text-slate-400">

                <i class="fa-solid
                          fa-spinner
                          fa-spin
                          mr-2"></i>

                AI đang suy nghĩ...

            </div>
            `;

        chatBox.appendChild(
            wrapper
        );

        chatBox.scrollTop =
            chatBox.scrollHeight;

    }


    function removeLoadingMessage(
        id
    ) {

        const element =
            document.getElementById(
                id
            );

        if (element) {

            element.remove();

        }

    }


    document
        .getElementById('chatQuestion')
        .addEventListener(
            'keydown',
            function (event) {

                if (event.key === 'Enter') {

                    event.preventDefault();

                    sendChat();

                }

            }
        );

    // Khởi tạo các chip câu hỏi nhanh ngay khi trang sẵn sàng
    renderQuickChips(defaultQuickChips);

</script>


