<script>

    // =========================================================
    // LẤY CSRF TOKEN
    // =========================================================

    function getCsrfToken() {

        const token =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

        return token
            ? token.value
            : '';

    }


    // Đọc response AI an toàn: ASP.NET có thể trả HTML/text khi lỗi CSRF/500.
    async function readAIJsonResponse(response, fallbackMessage) {
        const raw = await response.text();
        let data;

        try {
            data = JSON.parse(raw);
        }
        catch {
            const safeText =
                raw && !raw.trim().startsWith('<')
                    ? raw.trim().slice(0, 400)
                    : '';

            throw new Error(
                safeText || `${fallbackMessage} (HTTP ${response.status})`
            );
        }

        if (!response.ok || !data?.success) {
            throw new Error(
                data?.message || `${fallbackMessage} (HTTP ${response.status})`
            );
        }

        return data;
    }


    // =========================================================
    // HIỂN THỊ LỖI
    // =========================================================

    function showError(message) {

        alert(message);

    }


    // =========================================================
    // FR8
    // =========================================================

    async function tomTatInBody() {

        const button =
            document.getElementById(
                'btnInBody'
            );

        const loading =
            document.getElementById(
                'inBodyLoading'
            );

        const result =
            document.getElementById(
                'inBodyResult'
            );

        const text =
            document.getElementById(
                'inBodyText'
            );

        button.disabled = true;

        loading.classList.remove(
            'hidden'
        );

        result.classList.add(
            'hidden'
        );

        try {

            const response =
                await fetch(
                    '@Url.Action("AiTomTatInBody", "User")',
                    {
                        method: 'POST',

                        headers: {
                            'RequestVerificationToken':
                                getCsrfToken()
                        }
                    }
                );

            const data =
                await readAIJsonResponse(
                    response,
                    'Không thể gọi AI.'
                );

            text.textContent =
                data.data;

            result.classList.remove(
                'hidden'
            );

        }
        catch (error) {

            showError(
                error.message
            );

        }
        finally {

            button.disabled = false;

            loading.classList.add(
                'hidden'
            );

        }

    }


    // =========================================================
    // FR9
    // =========================================================

    async function sinhLich() {

        const button =
            document.getElementById(
                'btnSchedule'
            );

        const loading =
            document.getElementById(
                'scheduleLoading'
            );

        const result =
            document.getElementById(
                'scheduleResult'
            );

        const text =
            document.getElementById(
                'scheduleText'
            );

        const goal =
            document.getElementById(
                'aiGoal'
            ).value;

        const availability =
            document.getElementById(
                'aiTime'
            ).value;

        const level =
            document.getElementById(
                'aiLevel'
            ).value;

        button.disabled = true;

        loading.classList.remove(
            'hidden'
        );

        result.classList.add(
            'hidden'
        );

        try {

            const response =
                await fetch(
                    '@Url.Action("AiSinhLich", "User")',
                    {
                        method: 'POST',

                        headers: {
                            'Content-Type':
                                'application/json',

                            'RequestVerificationToken':
                                getCsrfToken()
                        },

                        body: JSON.stringify({
                            goal: goal,
                            availability: availability,
                            level: level
                        })
                    }
                );

            const data =
                await readAIJsonResponse(
                    response,
                    'Không thể tạo lịch AI.'
                );

            text.textContent =
                data.data;

            result.classList.remove(
                'hidden'
            );

        }
        catch (error) {

            showError(
                error.message
            );

        }
        finally {

            button.disabled = false;

            loading.classList.add(
                'hidden'
            );

        }

    }


    // =========================================================
    // FR10
    // =========================================================

            async function sendChat() {

            const input =
                document.getElementById('chatQuestion');

            const button =
                document.getElementById('btnChat');

            const question =
                input.value.trim();

            if (!question) {
                return;
            }


            // =====================================================
            // HIỂN THỊ CÂU HỎI NGƯỜI DÙNG
            // =====================================================
            addChatMessage(
                question,
                true
            );


            input.value = '';

            button.disabled = true;


            // =====================================================
            // LOADING
            // =====================================================
            const loadingId =
                'ai-loading-' + Date.now();

            addLoadingMessage(
                loadingId
            );


            try {

                // =================================================
                // CHỈ GỬI 6 TIN NHẮN GẦN NHẤT
                // =================================================
                const history =
                    aiConversationHistory
                        .slice(-4);


                const response =
                    await fetch(
                        '@Url.Action("AiChat", "User")',
                        {
                            method: 'POST',

                            headers: {
                                'Content-Type':
                                    'application/json',

                                'RequestVerificationToken':
                                    getCsrfToken()
                            },

                            body: JSON.stringify({
                                question: question,

                                history: history
                            })
                        }
                    );


                // =================================================
                // KHÔNG GỌI response.json() TRỰC TIẾP
                //
                // Vì nếu server trả HTML/error text,
                // response.json() sẽ gây:
                //
                // Unexpected end of JSON input
                // =================================================
                const responseText =
                    await response.text();


                let data;


                try {

                    data =
                        JSON.parse(responseText);

                }
                catch {

                    throw new Error(
                        responseText ||
                        `Server không trả JSON. HTTP ${response.status}`
                    );

                }


                removeLoadingMessage(
                    loadingId
                );


                if (!response.ok ||
                    !data.success) {

                    throw new Error(
                        data.message ||
                        'AI không thể trả lời.'
                    );

                }


                const aiAnswer =
                    data.data || '';


                // =================================================
                // HIỂN THỊ AI
                // =================================================
                addChatMessage(
                    aiAnswer,
                    false
                );


                // =================================================
                // LƯU LỊCH SỬ NHẸ
                //
                // Không lưu vô hạn.
                // Chỉ giữ tối đa 8 tin ở trình duyệt.
                // =================================================
                aiConversationHistory.push({
                    role: 'user',
                    content: question
                });


                aiConversationHistory.push({
                    role: 'assistant',
                    content: aiAnswer
                });


                while (
                    aiConversationHistory.length > 6
                ) {

                    aiConversationHistory.shift();

                }

            }
            catch (error) {

                removeLoadingMessage(
                    loadingId
                );


                addChatMessage(
                    error.message ||
                    'Không thể kết nối tới AI.',
                    false
                );

            }
            finally {

                button.disabled = false;

                input.focus();

            }
        }


    function addChatMessage(
        message,
        isUser
    ) {

        const chatBox =
            document.getElementById(
                'chatBox'
            );

        const wrapper =
            document.createElement(
                'div'
            );

        wrapper.className =
            isUser
                ? 'flex justify-end'
                : 'flex justify-start';

        const bubble =
            document.createElement(
                'div'
            );

        bubble.className =
            isUser
                ? 'max-w-[90%] rounded-xl bg-orange-500/10 border border-orange-500/20 p-3'
                : 'max-w-[90%] rounded-xl bg-violet-500/10 border border-violet-500/20 p-3';

        bubble.innerHTML =
            `
            <p class="text-sm
                      ${isUser
                        ? 'text-orange-300'
                        : 'text-violet-300'}
                      whitespace-pre-line
                      leading-7"></p>
            `;

        bubble.querySelector(
            'p'
        ).textContent = message;

        wrapper.appendChild(
            bubble
        );

        chatBox.appendChild(
            wrapper
        );

        chatBox.scrollTop =
            chatBox.scrollHeight;

    }


    function addLoadingMessage(
        id
    ) {

        const chatBox =
            document.getElementById(
                'chatBox'
            );

        const wrapper =
            document.createElement(
                'div'
            );

        wrapper.id = id;

        wrapper.className =
            'flex justify-start';

        wrapper.innerHTML =
            `
            <div class="rounded-xl
                        bg-slate-800
                        p-3
                        text-xs
                        text-slate-400">

                <i class="fa-solid
                          fa-spinner
                          fa-spin
                          mr-2"></i>

                AI đang suy nghĩ...

            </div>
            `;

        chatBox.appendChild(
            wrapper
        );

        chatBox.scrollTop =
            chatBox.scrollHeight;

    }


    function removeLoadingMessage(
        id
    ) {

        const element =
            document.getElementById(
                id
            );

        if (element) {

            element.remove();

        }

    }


    document
        .getElementById('chatQuestion')
        .addEventListener(
            'keydown',
            function (event) {

                if (event.key === 'Enter') {

                    event.preventDefault();

                    sendChat();

                }

            }
        );

</script>


<!-- CSRF TOKEN -->

<form class="hidden">

    @Html.AntiForgeryToken()

</form>

</body>

</html>