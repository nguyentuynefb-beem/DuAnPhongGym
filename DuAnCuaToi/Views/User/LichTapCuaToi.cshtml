@model List<DuAnCuaToi.Models.LichTap>

@{
    Layout = null;

    var currentUser =
        ViewBag.CurrentUser as DuAnCuaToi.Models.NguoiDung;

    var tenHienThi =
        currentUser?.HoTen
        ?? Context.Session.GetString("UserName")
        ?? "Hội viên";
}

<!DOCTYPE html>

<html lang="vi"
      class="bg-slate-950 text-slate-100">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Lịch tập của tôi - Smart Gym</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

</head>


<body class="min-h-screen bg-slate-950 text-slate-100">

<div class="min-h-screen">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="h-16
                   bg-slate-900
                   border-b border-slate-800
                   flex items-center justify-between
                   px-4 sm:px-6">

        <div class="flex items-center gap-3">

            <div class="w-9 h-9
                        bg-orange-500
                        rounded-lg
                        flex items-center
                        justify-center">

                <i class="fa-solid fa-dumbbell"></i>

            </div>

            <span class="font-bold text-white">
                SMART<span class="text-orange-500">GYM</span>
            </span>

        </div>


        <div class="flex items-center gap-4">

            <span class="text-sm text-slate-300">
                @tenHienThi
            </span>

            <a asp-controller="Home"
               asp-action="Logout"
               class="text-slate-400 hover:text-red-400">

                <i class="fa-solid fa-right-from-bracket"></i>

            </a>

        </div>

    </header>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="max-w-6xl mx-auto p-6">


        <!-- TIÊU ĐỀ -->

        <div class="flex flex-col
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                    gap-4
                    mb-8">

            <div>

                <h1 class="text-2xl font-black">

                    <i class="fa-solid fa-calendar-days
                              text-orange-500 mr-2"></i>

                    Lịch tập của tôi

                </h1>

                <p class="text-sm text-slate-400 mt-1">

                    Theo dõi lịch tập và trạng thái duyệt của PT.

                </p>

            </div>


            <a asp-controller="User"
               asp-action="Index"
               class="inline-flex
                      items-center
                      gap-2
                      px-4 py-2
                      bg-slate-800
                      hover:bg-slate-700
                      rounded-xl
                      text-sm">

                <i class="fa-solid fa-arrow-left"></i>

                Trang chủ

            </a>

        </div>


        <!-- =====================================================
             THỐNG KÊ
        ====================================================== -->

        <div class="grid
                    grid-cols-2
                    lg:grid-cols-4
                    gap-4
                    mb-8">


            <!-- TỔNG -->

            <div class="bg-slate-900
                        border border-slate-800
                        rounded-2xl
                        p-5">

                <p class="text-xs text-slate-500">
                    Tổng lịch
                </p>

                <p class="text-2xl
                          font-black
                          mt-2">

                    @ViewBag.TongLich

                </p>

            </div>


            <!-- CHỜ DUYỆT -->

            <div class="bg-slate-900
                        border border-amber-500/20
                        rounded-2xl
                        p-5">

                <p class="text-xs text-slate-500">
                    Chờ duyệt
                </p>

                <p class="text-2xl
                          font-black
                          text-amber-400
                          mt-2">

                    @ViewBag.SoLichChoDuyet

                </p>

            </div>


            <!-- ĐÃ DUYỆT -->

            <div class="bg-slate-900
                        border border-emerald-500/20
                        rounded-2xl
                        p-5">

                <p class="text-xs text-slate-500">
                    Đã duyệt
                </p>

                <p class="text-2xl
                          font-black
                          text-emerald-400
                          mt-2">

                    @ViewBag.SoLichDaDuyet

                </p>

            </div>


            <!-- TỪ CHỐI -->

            <div class="bg-slate-900
                        border border-red-500/20
                        rounded-2xl
                        p-5">

                <p class="text-xs text-slate-500">
                    Từ chối
                </p>

                <p class="text-2xl
                          font-black
                          text-red-400
                          mt-2">

                    @ViewBag.SoLichTuChoi

                </p>

            </div>

        </div>


        <!-- =====================================================
             DANH SÁCH LỊCH
        ====================================================== -->

        @if (Model != null && Model.Any())
        {

            <div class="space-y-4">

                @foreach (var lich in Model)
                {

                    var trangThaiClass =
                        lich.TrangThai == "DaDuyet"
                            ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
                            : lich.TrangThai == "TuChoi"
                                ? "bg-red-500/10 text-red-400 border-red-500/20"
                                : "bg-amber-500/10 text-amber-400 border-amber-500/20";


                    var trangThaiText =
                        lich.TrangThai == "DaDuyet"
                            ? "Đã duyệt"
                            : lich.TrangThai == "TuChoi"
                                ? "Từ chối"
                                : "Chờ duyệt";


                    <div class="bg-slate-900
                                border border-slate-800
                                rounded-2xl
                                p-5
                                shadow-lg">


                        <div class="flex flex-col
                                    lg:flex-row
                                    lg:items-center
                                    lg:justify-between
                                    gap-5">


                            <!-- THÔNG TIN -->

                            <div class="flex-1">


                                <div class="flex items-center gap-3 mb-3">

                                    <div class="w-11 h-11
                                                rounded-xl
                                                bg-orange-500/10
                                                text-orange-400
                                                flex items-center
                                                justify-center">

                                        <i class="fa-solid fa-calendar-check"></i>

                                    </div>


                                    <div>

                                        <h2 class="font-bold text-white">

                                            @lich.NgayTap.ToString("dd/MM/yyyy")

                                        </h2>

                                        <p class="text-xs text-slate-500">

                                            @if (!string.IsNullOrWhiteSpace(lich.KhungGio))
                                            {
                                                @lich.KhungGio
                                            }
                                            else
                                            {
                                                @($"{lich.ThoiGianBatDau:HH:mm} - {lich.ThoiGianKetThuc:HH:mm}")
                                            }

                                        </p>

                                    </div>

                                </div>


                                <!-- PT -->

                                <div class="flex items-center
                                            gap-2
                                            text-sm
                                            text-slate-300
                                            mb-2">

                                    <i class="fa-solid
                                              fa-user-tie
                                              text-orange-400
                                              w-5">
                                    </i>

                                    <span>

                                        PT:
                                        <strong class="text-white">

                                            @(lich.PT?.HoTen
                                                ?? lich.PTUsername
                                                ?? "Chưa xác định")

                                        </strong>

                                    </span>

                                </div>


                                <!-- NỘI DUNG -->

                                <div class="flex items-start
                                            gap-2
                                            text-sm
                                            text-slate-400">

                                    <i class="fa-solid
                                              fa-clipboard-list
                                              text-slate-500
                                              w-5
                                              mt-0.5">
                                    </i>

                                    <span>

                                        @(string.IsNullOrWhiteSpace(lich.NoiDung)
                                            ? "Chưa có nội dung tập"
                                            : lich.NoiDung)

                                    </span>

                                </div>

                            </div>


                            <!-- TRẠNG THÁI -->

                            <div class="flex flex-col
                                        items-start
                                        lg:items-end
                                        gap-3">


                                <span class="
                                    inline-flex
                                    items-center
                                    gap-2
                                    px-3 py-2
                                    rounded-full
                                    border
                                    text-xs
                                    font-bold
                                    @trangThaiClass
                                ">

                                    @if (lich.TrangThai == "DaDuyet")
                                    {
                                        <i class="fa-solid fa-circle-check"></i>
                                    }
                                    else if (lich.TrangThai == "TuChoi")
                                    {
                                        <i class="fa-solid fa-circle-xmark"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-clock"></i>
                                    }

                                    @trangThaiText

                                </span>


                                @if (lich.DaDiemDanh)
                                {

                                    <span class="text-xs
                                                 text-emerald-400">

                                        <i class="fa-solid fa-check-double"></i>

                                        Đã điểm danh

                                    </span>

                                }
                                else if (lich.TrangThai == "DaDuyet")
                                {

                                    <span class="text-xs
                                                 text-slate-500">

                                        Chưa điểm danh

                                    </span>

                                }

                            </div>

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="bg-slate-900
                        border border-slate-800
                        rounded-2xl
                        p-12
                        text-center">

                <i class="fa-solid
                          fa-calendar-xmark
                          text-5xl
                          text-slate-600">
                </i>

                <h2 class="text-lg
                           font-bold
                           mt-4">

                    Chưa có lịch tập

                </h2>

                <p class="text-sm
                          text-slate-500
                          mt-2">

                    Bạn chưa đăng ký lịch tập nào.

                </p>


                <a asp-controller="User"
                   asp-action="Index"
                   class="inline-flex
                          mt-5
                          px-4 py-2
                          bg-orange-500
                          hover:bg-orange-600
                          rounded-xl
                          text-sm
                          font-bold">

                    Về trang chủ

                </a>

            </div>

        }

    </main>

</div>

</body>

</html>