@model List<DuAnCuaToi.Models.CheckIn>

@{
    Layout = null;

    var currentUser =
        ViewBag.CurrentUser as DuAnCuaToi.Models.NguoiDung;

    var tenHienThi =
        currentUser?.HoTen
        ?? Context.Session.GetString("UserName")
        ?? "Hội viên";
}

<!DOCTYPE html>

<html lang="vi"
      class="bg-slate-950 text-slate-100">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Lịch sử điểm danh - Smart Gym</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

</head>


<body class="min-h-screen bg-slate-950 text-slate-100">

<div class="min-h-screen">


    <!-- HEADER -->

    <header class="h-16
                   bg-slate-900
                   border-b border-slate-800
                   flex items-center justify-between
                   px-4 sm:px-6">

        <div class="flex items-center gap-3">

            <div class="w-9 h-9
                        bg-orange-500
                        rounded-lg
                        flex items-center
                        justify-center">

                <i class="fa-solid fa-dumbbell"></i>

            </div>

            <span class="font-bold">
                SMART<span class="text-orange-500">GYM</span>
            </span>

        </div>


        <div class="flex items-center gap-4">

            <span class="text-sm text-slate-300">
                @tenHienThi
            </span>

            <a asp-controller="Home"
               asp-action="Logout"
               class="text-slate-400 hover:text-red-400">

                <i class="fa-solid fa-right-from-bracket"></i>

            </a>

        </div>

    </header>


    <!-- MAIN -->

    <main class="max-w-5xl mx-auto p-6">


        <!-- TITLE -->

        <div class="flex items-center
                    justify-between
                    gap-4
                    mb-8">

            <div>

                <h1 class="text-2xl font-black">

                    <i class="fa-solid fa-qrcode
                              text-orange-500 mr-2"></i>

                    Lịch sử điểm danh

                </h1>

                <p class="text-sm text-slate-400 mt-1">

                    Theo dõi các lần bạn đã điểm danh tại phòng gym.

                </p>

            </div>


            <a asp-controller="User"
               asp-action="Index"
               class="px-4 py-2
                      bg-slate-800
                      hover:bg-slate-700
                      rounded-xl
                      text-sm
                      whitespace-nowrap">

                <i class="fa-solid fa-arrow-left"></i>

                Trang chủ

            </a>

        </div>


        <!-- THỐNG KÊ -->

        <div class="grid grid-cols-1
                    sm:grid-cols-2
                    gap-4
                    mb-8">


            <div class="bg-slate-900
                        border border-slate-800
                        rounded-2xl
                        p-6">

                <p class="text-sm text-slate-500">

                    Tổng lượt điểm danh

                </p>

                <p class="text-3xl
                          font-black
                          text-orange-400
                          mt-2">

                    @ViewBag.TongLuotDiemDanh

                </p>

            </div>


            <div class="bg-slate-900
                        border border-slate-800
                        rounded-2xl
                        p-6">

                <p class="text-sm text-slate-500">

                    Điểm danh tháng này

                </p>

                <p class="text-3xl
                          font-black
                          text-emerald-400
                          mt-2">

                    @ViewBag.DiemDanhThangNay

                </p>

            </div>

        </div>


        <!-- DANH SÁCH -->

        @if (Model != null && Model.Any())
        {

            <div class="bg-slate-900
                        border border-slate-800
                        rounded-2xl
                        overflow-hidden">

                <div class="overflow-x-auto">

                    <table class="w-full text-sm">

                        <thead class="bg-slate-950">

                            <tr>

                                <th class="text-left
                                           px-5 py-4
                                           text-slate-500
                                           font-semibold">

                                    #

                                </th>

                                <th class="text-left
                                           px-5 py-4
                                           text-slate-500
                                           font-semibold">

                                    Ngày

                                </th>

                                <th class="text-left
                                           px-5 py-4
                                           text-slate-500
                                           font-semibold">

                                    Thời gian

                                </th>

                                <th class="text-left
                                           px-5 py-4
                                           text-slate-500
                                           font-semibold">

                                    Hình thức

                                </th>

                                <th class="text-left
                                           px-5 py-4
                                           text-slate-500
                                           font-semibold">

                                    Trạng thái

                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int stt = 1;
                            }

                            @foreach (var item in Model)
                            {

                                <tr class="border-t
                                           border-slate-800
                                           hover:bg-slate-800/50">

                                    <td class="px-5 py-4
                                               text-slate-500">

                                        @stt

                                    </td>


                                    <td class="px-5 py-4">

                                        <span class="font-semibold">

                                            @item.ThoiGian.ToString("dd/MM/yyyy")

                                        </span>

                                    </td>


                                    <td class="px-5 py-4">

                                        @item.ThoiGian.ToString("HH:mm:ss")

                                    </td>


                                    <td class="px-5 py-4">

                                        <span class="
                                            inline-flex
                                            items-center
                                            gap-2
                                            px-3 py-1
                                            rounded-full
                                            bg-blue-500/10
                                            text-blue-400
                                            text-xs
                                            font-semibold
                                        ">

                                            <i class="fa-solid fa-qrcode"></i>

                                            @(string.IsNullOrWhiteSpace(item.HinhThuc)
                                                ? "QR"
                                                : item.HinhThuc)

                                        </span>

                                    </td>


                                    <td class="px-5 py-4">

                                        <span class="
                                            inline-flex
                                            items-center
                                            gap-2
                                            text-emerald-400
                                            font-semibold
                                        ">

                                            <i class="fa-solid fa-circle-check"></i>

                                            Thành công

                                        </span>

                                    </td>

                                </tr>

                                stt++;

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        }
        else
        {

            <div class="bg-slate-900
                        border border-slate-800
                        rounded-2xl
                        p-12
                        text-center">

                <i class="fa-solid fa-qrcode
                          text-5xl
                          text-slate-600">
                </i>

                <h2 class="text-lg
                           font-bold
                           mt-4">

                    Chưa có lịch sử điểm danh

                </h2>

                <p class="text-sm
                          text-slate-500
                          mt-2">

                    Các lần điểm danh bằng QR sẽ xuất hiện tại đây.

                </p>

            </div>

        }

    </main>

</div>

</body>

</html>