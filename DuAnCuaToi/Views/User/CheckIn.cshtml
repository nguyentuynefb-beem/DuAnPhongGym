@using Microsoft.AspNetCore.Http
@{
    Layout = null;

    var currentUser =
        ViewBag.CurrentUser as DuAnCuaToi.Models.NguoiDung;

    var goiTapDangSuDung =
        ViewBag.GoiTapDangSuDung as DuAnCuaToi.Models.DangKyGoiTap;

    var goiTapCu =
        ViewBag.GoiTapCu as DuAnCuaToi.Models.DangKyGoiTap;

    var checkInHomNay =
        ViewBag.CheckInHomNay as DuAnCuaToi.Models.CheckIn;

    var lichSuDiemDanh =
        ViewBag.LichSuDiemDanh as List<DuAnCuaToi.Models.CheckIn> ?? new List<DuAnCuaToi.Models.CheckIn>();

    var tenHienThi =
        currentUser?.HoTen
        ?? Context.Session.GetString("UserName")
        ?? "Hội viên";

    var maHoiVien =
        currentUser?.MaHoiVien
        ?? "HV" + (currentUser?.Id.ToString("0000") ?? "0000");

    bool coGoiHopLe = goiTapDangSuDung != null;
    bool daDiemDanh = checkInHomNay != null;

    int soNgayConLai = 0;
    if (coGoiHopLe && goiTapDangSuDung != null)
    {
        soNgayConLai = Math.Max(0, (goiTapDangSuDung.NgayHetHan.Date - DateTime.Today).Days);
    }
}

<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-950">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#020617" />
    <title>Điểm danh vào phòng tập - SmartGym</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        body {
            background:
                radial-gradient(circle at 15% 0%, rgba(249,115,22,.08), transparent 30%),
                radial-gradient(circle at 85% 15%, rgba(16,185,129,.07), transparent 30%),
                #020617;
        }

        .glass {
            background: rgba(15,23,42,.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }

        .card {
            border: 1px solid rgba(51,65,85,.8);
            background: rgba(15,23,42,.92);
            border-radius: 1.25rem;
        }
    </style>
</head>

<body class="min-h-full text-slate-100 antialiased flex flex-col">

    <!-- HEADER -->
    <header class="sticky top-0 z-50 glass border-b border-slate-800">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center shadow-lg shadow-orange-500/20">
                    <i class="fa-solid fa-qrcode text-white text-lg"></i>
                </div>
                <div>
                    <div class="text-lg font-black tracking-wide text-white">
                        SMART<span class="text-orange-500">GYM</span>
                    </div>
                    <div class="text-[10px] text-slate-500 tracking-[.2em] font-semibold">
                        CHECK-IN HỘI VIÊN
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
                <a href="@Url.Action("LichSuDiemDanh", "User")"
                   class="px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 hover:border-slate-600 text-slate-300 text-xs font-semibold hover:text-white transition flex items-center gap-1.5">
                    <i class="fa-solid fa-clock-rotate-left text-amber-400"></i>
                    <span class="hidden sm:inline">Lịch sử</span>
                </a>

                <a href="@Url.Action("Index", "User")"
                   class="px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 hover:bg-slate-700 text-white text-xs font-semibold transition flex items-center gap-1.5">
                    <i class="fa-solid fa-house"></i>
                    <span class="hidden sm:inline">Trang chủ</span>
                </a>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">

        <!-- THÔNG BÁO FLASH -->
        @if (TempData["Success"] != null)
        {
            <div class="p-4 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-sm flex items-start gap-3 shadow-lg">
                <div class="w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center shrink-0 mt-0.5 text-emerald-400">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="flex-1 font-medium leading-6">
                    @TempData["Success"]
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="p-4 rounded-2xl bg-rose-500/15 border border-rose-500/40 text-rose-300 text-sm flex items-start gap-3 shadow-lg">
                <div class="w-6 h-6 rounded-full bg-rose-500/20 flex items-center justify-center shrink-0 mt-0.5 text-rose-400">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="flex-1 font-medium leading-6">
                    @TempData["Error"]
                </div>
            </div>
        }

        <!-- TIÊU ĐỀ -->
        <div class="text-center sm:text-left space-y-1">
            <div class="inline-flex items-center gap-2 rounded-full bg-orange-500/10 border border-orange-500/20 px-3 py-1 text-[11px] font-bold text-orange-400">
                <i class="fa-solid fa-location-dot"></i>
                CỬA VÀO PHÒNG TẬP
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-white">Xác nhận điểm danh</h1>
            <p class="text-slate-400 text-xs sm:text-sm">
                Chào mừng bạn đến với phòng tập SmartGym. Vui lòng kiểm tra gói tập và xác nhận vào tập.
            </p>
        </div>

        <!-- THÔNG TIN HỘI VIÊN & GÓI TẬP -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <!-- THẺ HỘI VIÊN -->
            <div class="card p-5 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <span class="text-xs uppercase tracking-wider font-bold text-slate-400">Hội viên</span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-800 text-amber-400 border border-slate-700">
                        @maHoiVien
                    </span>
                </div>

                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700 flex items-center justify-center text-2xl text-orange-400 shrink-0 shadow-inner">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="text-lg font-bold text-white truncate">@tenHienThi</div>
                        <div class="text-xs text-slate-400 mt-0.5">
                            Hội viên chính thức SmartGym
                        </div>
                        <div class="text-[11px] text-slate-500 mt-1 flex items-center gap-1.5">
                            <i class="fa-regular fa-calendar-check text-slate-400"></i>
                            Hôm nay: @DateTime.Today.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
            </div>

            <!-- THẺ HIỆU LỰC GÓI TẬP -->
            <div class="card p-5 space-y-4 flex flex-col justify-between">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <span class="text-xs uppercase tracking-wider font-bold text-slate-400">Tình trạng thẻ tập</span>
                    @if (coGoiHopLe)
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            Còn hiệu lực
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-500/10 text-rose-400 border border-rose-500/30">
                            <i class="fa-solid fa-circle-xmark text-[10px]"></i>
                            Không khả dụng
                        </span>
                    }
                </div>

                @if (coGoiHopLe && goiTapDangSuDung?.GoiTap != null)
                {
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-bold text-white">@goiTapDangSuDung.GoiTap.TenGoi</span>
                            <span class="text-xs text-slate-400">Còn <strong class="text-orange-400 font-bold">@soNgayConLai</strong> ngày</span>
                        </div>
                        <div class="text-xs text-slate-400 flex items-center gap-2">
                            <i class="fa-regular fa-clock text-emerald-400"></i>
                            <span>Hạn sử dụng: <strong>@goiTapDangSuDung.NgayHetHan.ToString("dd/MM/yyyy")</strong></span>
                        </div>
                        <div class="text-[11px] text-slate-500 line-clamp-1">
                            Quyền lợi: @(string.IsNullOrWhiteSpace(goiTapDangSuDung.GoiTap.QuyenLoi) ? "Tập tự do" : goiTapDangSuDung.GoiTap.QuyenLoi)
                        </div>
                    </div>
                }
                else if (goiTapCu?.GoiTap != null)
                {
                    <div class="space-y-2">
                        <div class="text-sm font-semibold text-rose-300">
                            Gói [@goiTapCu.GoiTap.TenGoi] đã hết hạn!
                        </div>
                        <div class="text-xs text-slate-400">
                            Hạn cuối: <span class="line-through">@goiTapCu.NgayHetHan.ToString("dd/MM/yyyy")</span>
                        </div>
                        <a href="@Url.Action("GoiTapCuaToi", "User")"
                           class="inline-flex items-center gap-1.5 text-xs text-orange-400 hover:text-orange-300 font-bold underline transition">
                            <i class="fa-solid fa-repeat"></i>
                            Gia hạn gói tập ngay
                        </a>
                    </div>
                }
                else
                {
                    <div class="space-y-2">
                        <div class="text-sm font-semibold text-amber-300">
                            Bạn chưa có gói tập nào được kích hoạt.
                        </div>
                        <div class="text-xs text-slate-400">
                            Vui lòng mua gói tập để có thể điểm danh vào phòng.
                        </div>
                        <a href="@Url.Action("GoiTapCuaToi", "User")"
                           class="inline-flex items-center gap-1.5 text-xs text-orange-400 hover:text-orange-300 font-bold underline transition">
                            <i class="fa-solid fa-cart-shopping"></i>
                            Đăng ký gói tập mới
                        </a>
                    </div>
                }
            </div>

        </div>

        <!-- KHU VỰC THAO TÁC ĐIỂM DANH CHÍNH -->
        <div class="card p-6 sm:p-8 text-center space-y-6">

            @if (daDiemDanh && checkInHomNay != null)
            {
                <!-- TRẠNG THÁI: ĐÃ ĐIỂM DANH HÔM NAY -->
                <div class="py-4 space-y-4">
                    <div class="w-20 h-20 mx-auto rounded-full bg-emerald-500/10 border-2 border-emerald-500/40 text-emerald-400 flex items-center justify-center text-3xl shadow-lg shadow-emerald-500/10">
                        <i class="fa-solid fa-check"></i>
                    </div>

                    <div class="space-y-1">
                        <h2 class="text-xl sm:text-2xl font-black text-white">
                            Bạn đã điểm danh hôm nay!
                        </h2>
                        <p class="text-slate-400 text-sm max-w-md mx-auto">
                            Thời gian ghi nhận:
                            <strong class="text-emerald-400 font-bold">@checkInHomNay.ThoiGian.ToString("HH:mm - dd/MM/yyyy")</strong>
                            (Hình thức: <span class="text-slate-300 font-semibold">@checkInHomNay.HinhThuc</span>)
                        </p>
                    </div>

                    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 max-w-md mx-auto text-xs text-slate-400 leading-relaxed">
                        <i class="fa-solid fa-dumbbell text-orange-400 mr-1.5"></i>
                        Chào mừng bạn đến buổi tập. Chúc bạn có những giờ phút rèn luyện thể lực thật hiệu quả và tràn đầy năng lượng!
                    </div>

                    <div class="pt-2">
                        <a href="@Url.Action("Index", "User")"
                           class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm transition shadow-lg">
                            <i class="fa-solid fa-arrow-left"></i>
                            Quay về trang cá nhân
                        </a>
                    </div>
                </div>
            }
            else if (coGoiHopLe)
            {
                <!-- TRẠNG THÁI: HỢP LỆ VÀ SẴN SÀNG ĐIỂM DANH -->
                <div class="py-4 space-y-5">
                    <div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-tr from-orange-500 to-amber-500 text-white flex items-center justify-center text-3xl shadow-xl shadow-orange-500/25 animate-pulse">
                        <i class="fa-solid fa-fingerprint"></i>
                    </div>

                    <div class="space-y-1 max-w-md mx-auto">
                        <h2 class="text-xl sm:text-2xl font-black text-white">
                            Sẵn sàng vào phòng tập!
                        </h2>
                        <p class="text-slate-400 text-xs sm:text-sm">
                            Gói tập <span class="text-emerald-400 font-bold">@(goiTapDangSuDung?.GoiTap?.TenGoi)</span> của bạn hợp lệ. Bấm nút bên dưới để xác nhận lượt vào tập hôm nay.
                        </p>
                    </div>

                    <form asp-action="ConfirmCheckIn" method="post" class="pt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="w-full sm:w-auto sm:min-w-[280px] px-8 py-4 rounded-2xl bg-gradient-to-r from-orange-500 via-orange-600 to-amber-600 hover:from-orange-600 hover:to-amber-700 text-white font-black text-base uppercase tracking-wider shadow-xl shadow-orange-500/30 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-3 mx-auto">
                            <i class="fa-solid fa-door-open text-lg"></i>
                            Xác nhận vào tập ngay
                        </button>
                    </form>

                    <p class="text-[11px] text-slate-500">
                        <i class="fa-solid fa-shield-halved mr-1"></i>
                        Hệ thống chỉ ghi nhận 01 lượt điểm danh vào cửa mỗi ngày cho mỗi hội viên.
                    </p>
                </div>
            }
            else
            {
                <!-- TRẠNG THÁI: KHÔNG THỂ ĐIỂM DANH DO GÓI HẾT HẠN HOẶC CHƯA CÓ -->
                <div class="py-4 space-y-4">
                    <div class="w-20 h-20 mx-auto rounded-full bg-rose-500/10 border-2 border-rose-500/40 text-rose-400 flex items-center justify-center text-3xl">
                        <i class="fa-solid fa-ban"></i>
                    </div>

                    <div class="space-y-1 max-w-md mx-auto">
                        <h2 class="text-xl sm:text-2xl font-black text-rose-400">
                            Không thể điểm danh
                        </h2>
                        <p class="text-slate-400 text-sm">
                            Bạn hiện chưa có gói tập nào còn hiệu lực. Vui lòng đăng ký mới hoặc liên hệ quầy Lễ tân để được hỗ trợ gia hạn thẻ.
                        </p>
                    </div>

                    <div class="pt-2 flex flex-col sm:flex-row justify-center gap-3">
                        <a href="@Url.Action("GoiTapCuaToi", "User")"
                           class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm transition shadow-lg shadow-orange-500/20">
                            <i class="fa-solid fa-cart-shopping"></i>
                            Xem các gói tập đang mở bán
                        </a>

                        <a href="@Url.Action("Index", "User")"
                           class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-sm transition">
                            <i class="fa-solid fa-arrow-left"></i>
                            Quay lại trang chủ
                        </a>
                    </div>
                </div>
            }

        </div>

        <!-- LỊCH SỬ 5 LẦN ĐIỂM DANH GẦN NHẤT -->
        <div class="card overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-amber-400"></i>
                    <h3 class="text-xs uppercase tracking-wider font-bold text-white">
                        Lịch sử điểm danh gần đây
                    </h3>
                </div>
                <a href="@Url.Action("LichSuDiemDanh", "User")"
                   class="text-xs text-orange-400 hover:text-orange-300 font-semibold transition">
                    Xem toàn bộ <i class="fa-solid fa-angle-right ml-1"></i>
                </a>
            </div>

            <div class="divide-y divide-slate-800">
                @if (lichSuDiemDanh.Count == 0)
                {
                    <div class="p-6 text-center text-slate-500 text-xs">
                        Bạn chưa có lượt điểm danh nào được ghi nhận.
                    </div>
                }
                else
                {
                    @foreach (var item in lichSuDiemDanh)
                    {
                        <div class="px-5 py-3 flex items-center justify-between text-xs hover:bg-white/[0.02] transition">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-slate-800 text-emerald-400 flex items-center justify-center font-bold">
                                    <i class="fa-solid fa-check"></i>
                                </div>
                                <div>
                                    <div class="font-bold text-slate-200">
                                        @item.ThoiGian.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="text-[11px] text-slate-400">
                                        Lúc @item.ThoiGian.ToString("HH:mm:ss")
                                    </div>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-slate-800 text-slate-300 border border-slate-700">
                                @(string.IsNullOrWhiteSpace(item.HinhThuc) ? "Mặc định" : item.HinhThuc)
                            </span>
                        </div>
                    }
                }
            </div>
        </div>

    </main>

    <!-- FOOTER -->
    <footer class="mt-auto py-6 border-t border-slate-900 text-center text-xs text-slate-500">
        <p>&copy; @DateTime.Now.Year SmartGym System. Tất cả quyền được bảo lưu.</p>
    </footer>

</body>
</html>
