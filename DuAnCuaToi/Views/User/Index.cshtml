        </div>

        <div class="flex items-center gap-3">
            @if (goiTapDangHoatDong?.GoiTap != null)
            {
                <a href="@Url.Action("GoiTapCuaToi", "User")" class="hidden xl:flex items-center gap-2 px-3 py-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
                    <i class="fa-solid fa-circle-check"></i>@goiTapDangHoatDong.GoiTap.TenGoi<span class="text-emerald-500/60">•</span>Còn @soNgayConLai ngày
                </a>
            }
            <a href="@Url.Action("ThongBao", "User")" class="relative w-10 h-10 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 flex items-center justify-center text-slate-300 hover:text-orange-400 transition">
                <i class="fa-solid fa-bell"></i>
                @if (soThongBaoChuaDoc > 0) { <span class="absolute -top-1 -right-1 min-w-5 h-5 px-1 rounded-full bg-red-500 text-white text-[9px] font-bold flex items-center justify-center">@soThongBaoChuaDoc</span> }
