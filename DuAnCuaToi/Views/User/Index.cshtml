<main class="flex-1 min-w-0">
    <header class="hidden lg:flex sticky top-0 z-40 h-16 items-center justify-between px-6 xl:px-8 glass border-b border-slate-800">
        <div>
            <p class="text-xs text-slate-500">TRANG HỘI VIÊN</p>
