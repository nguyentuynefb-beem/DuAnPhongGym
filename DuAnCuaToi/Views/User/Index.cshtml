@using Microsoft.AspNetCore.Http
@using System.Net
@using DuAnCuaToi.Models

@{
    Layout = null;
    var currentUser = ViewBag.CurrentUser as NguoiDung;
    var tenHienThi = currentUser?.HoTen ?? Context.Session.GetString("UserName") ?? "Hội viên";
    var username = currentUser?.TenDangNhap ?? Context.Session.GetString("Username") ?? "";
    var avatarUrl = $"https://ui-avatars.com/api/?name={WebUtility.UrlEncode(tenHienThi)}&background=ea580c&color=fff&size=128";
    var goiTapDangHoatDong = ViewBag.GoiTapDangHoatDong as DangKyGoiTap;
    var thongBaoMoiNhat = ViewBag.ThongBaoMoiNhat as ThongBao;

    int soThongBaoChuaDoc = 0;
    if (ViewBag.SoThongBaoChuaDoc != null)
        int.TryParse(ViewBag.SoThongBaoChuaDoc.ToString(), out soThongBaoChuaDoc);

    var soNgayConLai = goiTapDangHoatDong == null
        ? 0
        : Math.Max(0, (goiTapDangHoatDong.NgayHetHan.Date - DateTime.Now.Date).Days);

    var ngayHomNay = DateTime.Now.ToString("yyyy-MM-dd");
}

<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-950">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#020617" />
    <title>SmartGym - Trang hội viên</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: { 400: '#fb923c', 500: '#f97316', 600: '#ea580c', 700: '#c2410c' }
                    },
                    boxShadow: { glow: '0 0 35px rgba(249,115,22,.12)' }
                }
            }
        };
    </script>
    <style>
        html { scroll-behavior: smooth; }
        body {
            background:
                radial-gradient(circle at 15% 0%, rgba(249,115,22,.08), transparent 28%),
                radial-gradient(circle at 90% 10%, rgba(59,130,246,.06), transparent 24%),
                #020617;
        }
        .glass { background: rgba(15,23,42,.82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
        .card { border:1px solid rgba(51,65,85,.8); background:rgba(15,23,42,.88); border-radius:1rem; box-shadow:0 12px 30px rgba(0,0,0,.16); }
        .nav-item { display:flex; align-items:center; gap:.75rem; padding:.72rem .85rem; border-radius:.75rem; color:#94a3b8; transition:.2s ease; }
        .nav-item:hover { color:#fff; background:#1e293b; }
        .nav-item.active { color:#fff; background:rgba(249,115,22,.12); border:1px solid rgba(249,115,22,.2); }
        .nav-icon { width:2rem; height:2rem; display:flex; align-items:center; justify-content:center; border-radius:.6rem; background:#1e293b; flex-shrink:0; }
        .section-label { font-size:.68rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#64748b; margin:1.25rem .75rem .55rem; }
        .field { width:100%; background:#0f172a; border:1px solid #334155; border-radius:.75rem; padding:.7rem .8rem; color:#f8fafc; outline:none; }
        .field:focus { border-color:#f97316; box-shadow:0 0 0 3px rgba(249,115,22,.12); }
        .status-dot { width:.55rem; height:.55rem; border-radius:999px; background:#22c55e; box-shadow:0 0 0 4px rgba(34,197,94,.10); }
    </style>
</head>

<body class="min-h-full text-slate-100 antialiased">

