                        <p class="mt-1 text-lg font-black text-white">@DateTime.Now.ToString("dd/MM/yyyy")</p>
                        <p class="text-xs text-slate-500">@DateTime.Now.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</p>
                    </div>
                    <div class="rounded-2xl bg-slate-950/60 border border-slate-800 p-4">
                        <p class="text-[10px] uppercase tracking-wider text-slate-500 font-bold">Trạng thái</p>
                        @if (goiTapDangHoatDong?.GoiTap != null)
                        {
                            <p class="mt-1 text-lg font-black text-emerald-400">Đang hoạt động</p>
                            <p class="text-xs text-slate-500">Còn @soNgayConLai ngày</p>
                        }
                        else
                        {
                            <p class="mt-1 text-lg font-black text-red-400">Chưa kích hoạt</p>
                            <p class="text-xs text-slate-500">Vui lòng đăng ký gói</p>
                        }
                    </div>
                </div>
            </div>
        </section>

        <section>
