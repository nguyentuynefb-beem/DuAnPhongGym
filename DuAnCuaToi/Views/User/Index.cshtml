                <a href="@Url.Action("LichSuDiemDanh", "User")" class="group rounded-2xl border border-slate-800 bg-slate-900 p-4 hover:border-emerald-500/40 hover:bg-slate-800 transition"><div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center"><i class="fa-solid fa-qrcode"></i></div><p class="mt-3 text-sm font-bold text-white">Điểm danh</p><p class="mt-1 text-[11px] text-slate-500">Lịch sử ra vào</p></a>
                <a href="@Url.Action("LichSuThanhToan", "User")" class="group rounded-2xl border border-slate-800 bg-slate-900 p-4 hover:border-amber-500/40 hover:bg-slate-800 transition"><div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center"><i class="fa-solid fa-receipt"></i></div><p class="mt-3 text-sm font-bold text-white">Thanh toán</p><p class="mt-1 text-[11px] text-slate-500">Hóa đơn & giao dịch</p></a>
