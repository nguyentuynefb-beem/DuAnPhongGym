                <section class="rounded-2xl border border-slate-800 bg-slate-900 p-5">
                    <div class="flex items-center gap-3"><div class="w-9 h-9 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center"><i class="fa-solid fa-shield-halved"></i></div><div><p class="text-sm font-bold text-white">Hệ thống hoạt động</p><p class="text-[11px] text-slate-500">SmartGym Member Portal</p></div></div>
                    <div class="mt-4 flex items-center gap-2 text-xs text-emerald-400"><span class="status-dot"></span>Đã kết nối hệ thống</div>
                </section>
            </aside>
        </div>

        <footer class="pt-2 pb-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-[10px] text-slate-600">
            <span>© @DateTime.Now.Year SmartGym • Member Portal</span>
            <span>Quản lý tập luyện thông minh</span>
        </footer>
    </div>
</main>
</div>

<script>

    const aiDashboardConversationHistory = [];

    // =========================================================
    // MOBILE MENU
    // =========================================================
    function toggleMobileMenu() {
        document
            .getElementById('mobileMenu')
            .classList.toggle('hidden');
    }


    // =========================================================
    // CSRF TOKEN
    // =========================================================
    function getCsrfToken() {

        const token =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

        return token
            ? token.value
            : '';
    }


    // Đọc response AI an toàn: ASP.NET có thể trả HTML/text khi lỗi CSRF/500.
    async function readAIJsonResponse(response, fallbackMessage) {
        const raw = await response.text();
        let data;

        try {
            data = JSON.parse(raw);
        }
        catch {
            const safeText =
                raw && !raw.trim().startsWith('<')
                    ? raw.trim().slice(0, 400)
                    : '';

            throw new Error(
                safeText || `${fallbackMessage} (HTTP ${response.status})`
            );
        }

        if (!response.ok || !data?.success) {
            throw new Error(
                data?.message || `${fallbackMessage} (HTTP ${response.status})`
            );
        }

        return data;
    }


    // =========================================================
    // HIỂN THỊ LỖI
    // =========================================================
            function showAIError(message) {

            const output =
                document.getElementById('aiOutput');

            const list =
                document.getElementById('aiScheduleList');


            output.classList.remove(
                'hidden'
            );


            list.innerHTML = '';


            const box =
                document.createElement('div');

            box.className =
                'rounded-xl border border-red-500/20 ' +
                'bg-red-500/5 p-4 text-sm text-red-300';


            box.textContent =
                message;


            list.appendChild(
                box
            );
        }


    // =========================================================
    // FR8 - AI PHÂN TÍCH INBODY
    // =========================================================
    async function generateAIProgress() {

        const button =
            document.getElementById(
                'btnAIProgress'
            );

        const loading =
            document.getElementById(
                'aiProgressLoading'
            );

        const result =
            document.getElementById(
                'aiProgressResult'
            );

        const text =
            document.getElementById(
                'aiProgressText'
            );

        button.disabled = true;

        loading.classList.remove(
            'hidden'
        );

        result.classList.add(
            'hidden'
        );

        try {

            const response =
                await fetch(
                    '@Url.Action("AiTomTatInBody", "User")',
                    {
                        method: 'POST',

                        headers: {
                            'RequestVerificationToken':
                                getCsrfToken()
                        }
                    }
                );

            const data =
                await readAIJsonResponse(
                    response,
                    'Không thể phân tích tiến độ.'
                );

            text.textContent =
                data.data;

            result.classList.remove(
                'hidden'
            );

        }
        catch (error) {

            showAIError(
                error.message
            );

        }
        finally {

            button.disabled = false;

            loading.classList.add(
                'hidden'
            );
        }
    }


    // =========================================================
    // FR9 - AI SINH LỊCH 7 NGÀY
    // =========================================================
                    async function generateAISchedule() {

            const button =
                document.getElementById('btnAISchedule');

            const loading =
                document.getElementById('aiLoading');

            const output =
                document.getElementById('aiOutput');

            const list =
                document.getElementById('aiScheduleList');

            const goal =
                document.getElementById('aiGoal')?.value?.trim() || '';

            const availability =
                document.getElementById('aiTime')?.value?.trim() || '';

            const level =
                document.getElementById('aiLevel')?.value?.trim() || '';


            // ---------------------------------------------------------
            // Validate
            // ---------------------------------------------------------

            if (!goal) {

                showAIError(
                    'Vui lòng chọn mục tiêu tập luyện.'
                );

                return;
            }


            if (!availability) {

                showAIError(
                    'Vui lòng nhập thời gian rảnh.'
                );

                return;
            }


            if (!level) {

                showAIError(
                    'Vui lòng chọn trình độ.'
                );

                return;
            }


            // ---------------------------------------------------------
            // UI loading
            // ---------------------------------------------------------

            button.disabled = true;

            button.classList.add(
                'opacity-60',
                'cursor-not-allowed'
            );

            loading.classList.remove(
                'hidden'
            );

            output.classList.add(
                'hidden'
            );

            list.innerHTML = '';


            try {

                const token =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    )?.value || '';


                const response =
                    await fetch(
                        '@Url.Action("AiSinhLich", "User")',
                        {
                            method: 'POST',

                            headers: {
                                'Content-Type':
                                    'application/json',

                                'RequestVerificationToken':
                                    token
                            },

                            body: JSON.stringify({

                                goal:
                                    goal,

                                availability:
                                    availability,

                                level:
                                    level

                            })
                        }
                    );


                // -----------------------------------------------------
                // Đọc text trước rồi mới JSON.parse
                // -----------------------------------------------------

                const raw =
                    await response.text();


                let data;


                try {

                    data =
                        JSON.parse(raw);

                }
                catch {

                    throw new Error(
                        raw ||
                        `Server trả dữ liệu không hợp lệ. HTTP ${response.status}`
                    );

                }


                if (!response.ok) {

                    throw new Error(
                        data.message ||
                        'Không thể tạo lịch AI.'
                    );

                }


                if (!data.success) {

                    throw new Error(
                        data.message ||
                        'AI không thể tạo lịch.'
                    );

                }


                const result =
                    data.data || '';


                if (!result.trim()) {

                    throw new Error(
                        'AI không trả về nội dung.'
                    );

                }


                // -----------------------------------------------------
                // Hiển thị kết quả AI
                // -----------------------------------------------------

                list.textContent =
                    result;


                output.classList.remove(
                    'hidden'
                );


                // Cuộn nhẹ tới kết quả
                output.scrollIntoView({
                    behavior: 'smooth',
                    block: 'nearest'
                });


            }
            catch (error) {

                showAIError(
                    error.message ||
                    'Không thể kết nối tới SmartGym AI.'
                );

            }
            finally {

                button.disabled = false;

                button.classList.remove(
                    'opacity-60',
                    'cursor-not-allowed'
                );

                loading.classList.add(
                    'hidden'
                );

            }
        }


    // =========================================================
    // FR10 - AI ASSISTANT
    // =========================================================
    async function sendAIChat() {

        const input =
            document.getElementById(
                'aiChatQuestion'
            );

        const button =
            document.getElementById(
                'btnAIChat'
            );

        const chatBox =
            document.getElementById(
                'aiChatBox'
            );

        const question =
            input.value.trim();

        if (!question) {

            return;
        }

        addAIChatMessage(
            question,
            true
        );

        input.value = '';

        button.disabled = true;

        const loadingId =
            'ai-chat-loading-' +
            Date.now();

        addAILoadingMessage(
            loadingId
        );

        try {

            const response =
                await fetch(
                    '@Url.Action("AiChat", "User")',
                    {
                        method: 'POST',

                        headers: {
                            'Content-Type':
                                'application/json',

                            'RequestVerificationToken':
                                getCsrfToken()
                        },

                        body: JSON.stringify({
                            question: question,
                            history: aiDashboardConversationHistory.slice(-4)
                        })
                    }
                );

            const data =
                await readAIJsonResponse(
                    response,
                    'AI không thể trả lời.'
                );

            removeAILoadingMessage(
                loadingId
            );

            addAIChatMessage(
                data.data,
                false
            );

            aiDashboardConversationHistory.push({
                role: 'user',
                content: question
            });

            aiDashboardConversationHistory.push({
                role: 'assistant',
                content: data.data || ''
            });

            while (aiDashboardConversationHistory.length > 6) {
                aiDashboardConversationHistory.shift();
            }

        }
        catch (error) {

            removeAILoadingMessage(
                loadingId
            );

            addAIChatMessage(
                error.message,
                false
            );
        }
        finally {

            button.disabled = false;

            input.focus();
        }
    }


    // =========================================================
    // THÊM MESSAGE CHAT
    // =========================================================
    function addAIChatMessage(
        message,
        isUser
    ) {

        const chatBox =
            document.getElementById(
                'aiChatBox'
            );

        const wrapper =
            document.createElement(
                'div'
            );

        wrapper.className =
            isUser
                ? 'flex justify-end'
                : 'flex justify-start';

        const bubble =
            document.createElement(
                'div'
            );

        bubble.className =
            isUser
                ? 'max-w-[90%] rounded-xl bg-orange-500/10 border border-orange-500/20 p-3'
                : 'max-w-[90%] rounded-xl bg-violet-500/10 border border-violet-500/20 p-3';

        const text =
            document.createElement(
                'p'
            );

        text.className =
            isUser
                ? 'text-xs text-orange-300 whitespace-pre-line leading-5'
                : 'text-xs text-violet-300 whitespace-pre-line leading-5';

        text.textContent =
            message;

        bubble.appendChild(
            text
        );

        wrapper.appendChild(
            bubble
        );

        chatBox.appendChild(
            wrapper
        );

        chatBox.scrollTop =
            chatBox.scrollHeight;
    }


    // =========================================================
    // LOADING CHAT
    // =========================================================
    function addAILoadingMessage(id) {

        const chatBox =
            document.getElementById(
                'aiChatBox'
            );

        const wrapper =
            document.createElement(
                'div'
            );

        wrapper.id = id;

        wrapper.className =
            'flex justify-start';

        wrapper.innerHTML = `
            <div class="rounded-xl
                        bg-slate-800
                        border border-slate-700
                        p-3
                        text-xs
                        text-slate-400">

                <i class="fa-solid
                          fa-spinner
                          fa-spin
                          mr-2"></i>

                AI đang suy nghĩ...

            </div>
        `;

        chatBox.appendChild(
            wrapper
        );

        chatBox.scrollTop =
            chatBox.scrollHeight;
    }


    function removeAILoadingMessage(id) {

        const element =
            document.getElementById(
                id
            );

        if (element) {

            element.remove();
        }
    }


    // =========================================================
    // ENTER ĐỂ GỬI CHAT
    // =========================================================
    document
        .getElementById('aiChatQuestion')
        ?.addEventListener(
            'keydown',
            function(event) {

                if (event.key === 'Enter') {

                    event.preventDefault();

                    sendAIChat();
                }
            }
        );
        // =========================================================
// CÂU HỎI NHANH
// =========================================================
function askQuickAI(question) {

    const input =
        document.getElementById(
            'aiChatQuestion'
        );

    input.value = question;

    sendAIChat();
}
</script>
