@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf

@{
    Layout = null;
    var adminName = Context.Session.GetString("UserName") ?? Context.Session.GetString("Username") ?? "Quản Trị Viên";
    var token = Xsrf.GetAndStoreTokens(Context).RequestToken;
    var doanhThuThang = (decimal)(ViewBag.DoanhThuThang ?? 0);
    var tongHoiVien = (int)(ViewBag.TongHoiVien ?? 0);
    var checkInHomNay = (int)(ViewBag.CheckInHomNay ?? 0);
    var goiTapHoatDong = (int)(ViewBag.GoiTapHoatDong ?? 0);
}

<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trợ Lý AI Quản Lý - SmartGym Executive</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            500: '#f97316',
                            600: '#ea580c'
                        }
                    }
                }
            }
        };
    </script>
    <style>
        body {
            background: radial-gradient(circle at 10% 0%, rgba(249, 115, 22, 0.08), transparent 30%),
                        radial-gradient(circle at 90% 20%, rgba(59, 130, 246, 0.06), transparent 30%),
                        #020617;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(51, 65, 85, 0.6);
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.5);
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        /* Markdown tables and elements styling */
        .ai-prose table {
            width: 100%;
            margin: 0.75rem 0;
            border-collapse: collapse;
            font-size: 0.825rem;
            border: 1px solid #334155;
            border-radius: 0.5rem;
            overflow: hidden;
        }
        .ai-prose th {
            background-color: #1e293b;
            color: #f1f5f9;
            font-weight: 600;
            padding: 0.5rem 0.75rem;
            text-align: left;
            border: 1px solid #334155;
        }
        .ai-prose td {
            padding: 0.5rem 0.75rem;
            border: 1px solid #334155;
            color: #cbd5e1;
        }
        .ai-prose tr:nth-child(even) {
            background-color: rgba(30, 41, 59, 0.4);
        }
        .ai-prose p {
            margin-bottom: 0.6rem;
            line-height: 1.6;
        }
        .ai-prose ul, .ai-prose ol {
            margin-left: 1.25rem;
            margin-bottom: 0.6rem;
        }
        .ai-prose li {
            margin-bottom: 0.3rem;
            line-height: 1.5;
        }
        .ai-prose ul {
            list-style-type: disc;
        }
        .ai-prose ol {
            list-style-type: decimal;
        }
        .ai-prose strong {
            color: #f8fafc;
            font-weight: 700;
        }
        .ai-prose code {
            background: rgba(30, 41, 59, 0.8);
            padding: 0.15rem 0.35rem;
            border-radius: 0.25rem;
            color: #fdba74;
            font-family: monospace;
            font-size: 0.85em;
        }

        @@keyframes pulseGlow {
            0%, 100% { opacity: 0.4; }
            50% { opacity: 0.8; }
        }
        .glow-pulse {
            animation: pulseGlow 2.5s infinite ease-in-out;
        }
    </style>
</head>
<body class="h-full flex flex-col overflow-hidden">
    <!-- TOP HEADER -->
    <header class="h-16 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between px-4 sm:px-6 z-20 shrink-0">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="p-2 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white transition text-xs flex items-center gap-1.5" title="Quay lại Dashboard">
                <i class="fa-solid fa-arrow-left"></i>
                <span class="hidden sm:inline font-medium">Dashboard</span>
            </a>
            <div class="h-5 w-[1px] bg-slate-800"></div>
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-orange-600 via-amber-500 to-amber-400 flex items-center justify-center shadow-lg shadow-orange-500/20 text-white font-black text-sm">
                    <i class="fa-solid fa-brain"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-sm sm:text-base font-bold text-white tracking-tight">SmartGym Executive AI</h1>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30">Admin Advisor</span>
                    </div>
                    <p class="text-[11px] text-slate-400 hidden sm:block">Trợ lý Cố vấn Chiến lược & Quản trị Toàn quyền</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <div class="text-right hidden sm:block">
                <div class="text-xs font-semibold text-slate-200">@adminName</div>
                <div class="text-[10px] text-emerald-400 flex items-center justify-end gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Toàn quyền truy cập dữ liệu
                </div>
            </div>
            <button id="btn-clear-chat" onclick="clearConversation()" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-medium transition flex items-center gap-1.5" title="Làm mới cuộc trò chuyện">
                <i class="fa-solid fa-arrows-rotate text-[11px]"></i>
                <span class="hidden md:inline">Làm mới hội thoại</span>
            </button>
        </div>
    </header>

    <!-- KPI STATS BAR (DỮ LIỆU THỜI GIAN THỰC) -->
    <section class="bg-slate-900/40 border-b border-slate-800/80 px-4 sm:px-6 py-2.5 shrink-0">
        <div class="max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4">
            <div class="bg-slate-950/60 border border-slate-800/60 rounded-xl p-2.5 flex items-center justify-between">
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Doanh thu tháng</div>
                    <div class="text-xs sm:text-sm font-extrabold text-emerald-400">@doanhThuThang.ToString("N0") đ</div>
                </div>
                <div class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-wallet"></i>
                </div>
            </div>

            <div class="bg-slate-950/60 border border-slate-800/60 rounded-xl p-2.5 flex items-center justify-between">
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Tổng hội viên</div>
                    <div class="text-xs sm:text-sm font-extrabold text-blue-400">@tongHoiVien.ToString("N0") người</div>
                </div>
                <div class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-users"></i>
                </div>
            </div>

            <div class="bg-slate-950/60 border border-slate-800/60 rounded-xl p-2.5 flex items-center justify-between">
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Check-in hôm nay</div>
                    <div class="text-xs sm:text-sm font-extrabold text-amber-400">@checkInHomNay.ToString("N0") lượt</div>
                </div>
                <div class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-qrcode"></i>
                </div>
            </div>

            <div class="bg-slate-950/60 border border-slate-800/60 rounded-xl p-2.5 flex items-center justify-between">
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Gói đang hoạt động</div>
                    <div class="text-xs sm:text-sm font-extrabold text-orange-400">@goiTapHoatDong.ToString("N0") gói</div>
                </div>
                <div class="w-7 h-7 rounded-lg bg-orange-500/10 text-orange-400 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-cubes"></i>
                </div>
            </div>
        </div>
    </section>

    <!-- MAIN CHAT CONTAINER -->
    <div class="flex-1 flex flex-col md:flex-row overflow-hidden max-w-7xl w-full mx-auto p-3 sm:p-4 gap-3">
        <!-- SIDEBAR GỢI Ý CÂU HỎI QUẢN TRỊ (DESKTOP) -->
        <aside class="hidden lg:flex flex-col w-72 shrink-0 glass-panel rounded-2xl p-4 gap-3 border border-slate-800/80">
            <div class="flex items-center gap-2 text-xs font-bold text-slate-300">
                <i class="fa-solid fa-lightbulb text-amber-400"></i>
                <span>GỢI Ý CÂU HỎI CHIẾN LƯỢC</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
                Là Admin, bạn có toàn quyền tra cứu bất kỳ số liệu doanh thu, tài khoản, check-in và nhận tư vấn tối ưu doanh thu.
            </p>

            <div class="space-y-2 overflow-y-auto flex-1 pr-1">
                <button onclick="askPrompt('Báo cáo phân tích doanh thu tháng này chi tiết, so sánh với tháng trước và đánh giá tỷ lệ tăng trưởng?')" class="w-full text-left p-2.5 rounded-xl bg-slate-900/70 hover:bg-orange-500/10 border border-slate-800 hover:border-orange-500/40 text-[11px] text-slate-300 hover:text-orange-300 transition duration-150 flex items-start gap-2">
                    <i class="fa-solid fa-chart-line text-emerald-400 mt-0.5 shrink-0"></i>
                    <span>Phân tích doanh thu & tăng trưởng so với tháng trước</span>
                </button>

                <button onclick="askPrompt('Hiện tại hệ thống có bao nhiêu tài khoản theo từng vai trò? Có bao nhiêu gói tập đang hoạt động và sắp hết hạn?')" class="w-full text-left p-2.5 rounded-xl bg-slate-900/70 hover:bg-orange-500/10 border border-slate-800 hover:border-orange-500/40 text-[11px] text-slate-300 hover:text-orange-300 transition duration-150 flex items-start gap-2">
                    <i class="fa-solid fa-users text-blue-400 mt-0.5 shrink-0"></i>
                    <span>Thống kê chi tiết tài khoản theo vai trò & gói tập</span>
                </button>

                <button onclick="askPrompt('Top các gói tập nào đang bán chạy nhất và tỷ lệ doanh thu qua các phương thức thanh toán ra sao?')" class="w-full text-left p-2.5 rounded-xl bg-slate-900/70 hover:bg-orange-500/10 border border-slate-800 hover:border-orange-500/40 text-[11px] text-slate-300 hover:text-orange-300 transition duration-150 flex items-start gap-2">
                    <i class="fa-solid fa-crown text-amber-400 mt-0.5 shrink-0"></i>
                    <span>Top gói tập bán chạy & cơ cấu thanh toán</span>
                </button>

                <button onclick="askPrompt('Đánh giá hoạt động của đội ngũ PT hiện tại: số học viên phụ trách và số lịch dạy của từng huấn luyện viên?')" class="w-full text-left p-2.5 rounded-xl bg-slate-900/70 hover:bg-orange-500/10 border border-slate-800 hover:border-orange-500/40 text-[11px] text-slate-300 hover:text-orange-300 transition duration-150 flex items-start gap-2">
                    <i class="fa-solid fa-dumbbell text-purple-400 mt-0.5 shrink-0"></i>
                    <span>Đánh giá hiệu suất học viên & lịch dạy của đội ngũ PT</span>
                </button>

                <button onclick="askPrompt('Tình hình check-in hôm nay và tuần này thế nào? Đề xuất giải pháp tăng tỷ lệ khách đến tập vào khung giờ thấp điểm?')" class="w-full text-left p-2.5 rounded-xl bg-slate-900/70 hover:bg-orange-500/10 border border-slate-800 hover:border-orange-500/40 text-[11px] text-slate-300 hover:text-orange-300 transition duration-150 flex items-start gap-2">
                    <i class="fa-solid fa-door-open text-orange-400 mt-0.5 shrink-0"></i>
                    <span>Tình hình check-in & chiến lược khung giờ thấp điểm</span>
                </button>

                <button onclick="askPrompt('Đề xuất kế hoạch khuyến mãi hoặc chiến dịch marketing để thúc đẩy hội viên gia hạn các gói sắp hết hạn trong 7 ngày tới?')" class="w-full text-left p-2.5 rounded-xl bg-slate-900/70 hover:bg-orange-500/10 border border-slate-800 hover:border-orange-500/40 text-[11px] text-slate-300 hover:text-orange-300 transition duration-150 flex items-start gap-2">
                    <i class="fa-solid fa-bullhorn text-pink-400 mt-0.5 shrink-0"></i>
                    <span>Chiến lược marketing thúc đẩy gia hạn gói sắp hết hạn</span>
                </button>
            </div>

            <div class="p-2.5 rounded-xl bg-slate-900/80 border border-slate-800 text-[10px] text-slate-400">
                <i class="fa-solid fa-shield-halved text-emerald-400 me-1"></i>
                Hội viên thường không thể truy cập các thông tin doanh thu và tài khoản hệ thống.
            </div>
        </aside>

        <!-- CHAT AREA -->
        <main class="flex-1 flex flex-col glass-panel rounded-2xl overflow-hidden border border-slate-800/80">
            <!-- CHAT MESSAGES LIST -->
            <div id="chat-messages" class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-4">
                <!-- Tin nhắn chào mừng ban đầu từ AI -->
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-orange-600 via-amber-500 to-amber-400 flex items-center justify-center text-white text-xs font-bold shrink-0 shadow-md shadow-orange-500/20">
                        <i class="fa-solid fa-brain"></i>
                    </div>
                    <div class="max-w-[85%] sm:max-w-[80%] bg-slate-900/90 border border-slate-800/90 rounded-2xl rounded-tl-sm p-4 text-xs sm:text-sm text-slate-200 shadow-md">
                        <div class="flex items-center justify-between mb-2 pb-1.5 border-b border-slate-800">
                            <span class="font-bold text-amber-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-sparkles"></i>
                                SmartGym Executive Advisor
                            </span>
                            <span class="text-[10px] text-slate-500">Hệ thống sẵn sàng</span>
                        </div>
                        <div class="ai-prose space-y-2">
                            <p>Xin chào <strong>@adminName</strong>! Tôi là Cố vấn Điều hành AI cấp cao của trung tâm SmartGym.</p>
                            <p>Tôi đã đồng bộ toàn bộ dữ liệu hệ thống: <strong>Doanh thu tài chính</strong>, <strong>thống kê người dùng theo vai trò</strong>, <strong>tình trạng gói tập</strong>, <strong>lượt check-in</strong> và <strong>hoạt động đội ngũ PT</strong>.</p>
                            <p>Tôi có thể giúp bạn giải đáp mọi thông tin, lập báo cáo phân tích chuyên sâu hoặc đề xuất chiến lược phát triển kinh doanh. Hãy chọn một câu hỏi gợi ý hoặc nhập yêu cầu trực tiếp bên dưới!</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHIP GỢI Ý NHANH TRÊN MOBILE / DESKTOP -->
            <div class="px-4 py-2 border-t border-slate-800/60 bg-slate-950/40 flex items-center gap-2 overflow-x-auto text-[11px] no-scrollbar">
                <span class="text-slate-400 text-[10px] uppercase font-bold shrink-0"><i class="fa-solid fa-bolt text-amber-400 me-1"></i>Hỏi nhanh:</span>
                <button onclick="askPrompt('Doanh thu hôm nay và tháng này là bao nhiêu?')" class="shrink-0 px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 hover:border-orange-500/50 text-slate-300 hover:text-white transition">
                    Doanh thu hôm nay & tháng này
                </button>
                <button onclick="askPrompt('Tổng số tài khoản và phân bổ theo vai trò trong hệ thống?')" class="shrink-0 px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 hover:border-orange-500/50 text-slate-300 hover:text-white transition">
                    Số tài khoản theo vai trò
                </button>
                <button onclick="askPrompt('Gói tập nào bán chạy nhất và tỷ lệ phương thức thanh toán?')" class="shrink-0 px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 hover:border-orange-500/50 text-slate-300 hover:text-white transition">
                    Gói bán chạy & thanh toán
                </button>
                <button onclick="askPrompt('Tình hình check-in hôm nay và tuần này ra sao?')" class="shrink-0 px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 hover:border-orange-500/50 text-slate-300 hover:text-white transition">
                    Lượt check-in
                </button>
            </div>

            <!-- CHAT INPUT FORM -->
            <div class="p-3 sm:p-4 bg-slate-900/90 border-t border-slate-800 shrink-0">
                <form id="chat-form" onsubmit="handleSend(event)" class="relative flex items-center gap-2">
                    @Html.AntiForgeryToken()
                    <textarea id="chat-input"
                              rows="1"
                              maxlength="1200"
                              placeholder="Hỏi AI về doanh thu, số tài khoản, check-in, PT hoặc chiến lược vận hành... (Enter để gửi)"
                              class="w-full bg-slate-950/80 border border-slate-800 focus:border-orange-500 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-100 placeholder-slate-500 focus:outline-none transition resize-none leading-relaxed"
                              onkeydown="handleKeyDown(event)"></textarea>

                    <button type="submit"
                            id="btn-send"
                            class="bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 text-white font-bold p-3 sm:px-5 sm:py-3 rounded-xl text-xs sm:text-sm transition shadow-lg shadow-orange-500/20 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed shrink-0">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span class="hidden sm:inline">Gửi</span>
                    </button>
                </form>
                <div class="flex items-center justify-between mt-2 px-1 text-[10px] text-slate-500">
                    <div>
                        <span id="char-count">0</span>/1200 ký tự • Giữ Shift + Enter để xuống dòng
                    </div>
                    <div class="flex items-center gap-1 text-amber-500/80">
                        <i class="fa-solid fa-lock text-[9px]"></i>
                        <span>Bảo mật nội bộ cấp Admin</span>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- SCRIPT CLIENT -->
    <script>
        const antiForgeryToken = '@token';
        let conversationHistory = [];
        let isProcessing = false;

        const chatInput = document.getElementById('chat-input');
        const chatMessages = document.getElementById('chat-messages');
        const charCount = document.getElementById('char-count');
        const btnSend = document.getElementById('btn-send');

        // Tự động co giãn textarea và đếm ký tự
        chatInput.addEventListener('input', function () {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            charCount.textContent = this.value.length;
        });

        function handleKeyDown(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                handleSend(e);
            }
        }

        function askPrompt(text) {
            chatInput.value = text;
            chatInput.dispatchEvent(new Event('input'));
            handleSend(new Event('submit'));
        }

        async function handleSend(e) {
            if (e) e.preventDefault();
            const question = chatInput.value.trim();
            if (!question || isProcessing) return;

            isProcessing = true;
            btnSend.disabled = true;
            chatInput.disabled = true;

            // 1. Thêm tin nhắn của Admin vào UI
            appendUserMessage(question);
            chatInput.value = '';
            chatInput.style.height = 'auto';
            charCount.textContent = '0';

            // 2. Thêm bong bóng loading của AI
            const loadingId = appendLoadingIndicator();

            try {
                const response = await fetch('/Admin/AiChatAdmin', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify({
                        Question: question,
                        History: conversationHistory
                    })
                });

                const result = await response.json();
                removeElement(loadingId);

                if (result.success && result.data) {
                    appendAiMessage(result.data);

                    // Cập nhật lịch sử
                    conversationHistory.push({ Role: 'user', Content: question });
                    conversationHistory.push({ Role: 'assistant', Content: result.data });

                    if (conversationHistory.length > 10) {
                        conversationHistory = conversationHistory.slice(-10);
                    }
                } else {
                    appendErrorMessage(result.message || 'Không thể nhận phản hồi từ AI.');
                }
            } catch (err) {
                removeElement(loadingId);
                appendErrorMessage('Lỗi kết nối đến máy chủ. Vui lòng kiểm tra mạng và thử lại.');
            } finally {
                isProcessing = false;
                btnSend.disabled = false;
                chatInput.disabled = false;
                chatInput.focus();
            }
        }

        function appendUserMessage(text) {
            const div = document.createElement('div');
            div.className = 'flex items-start justify-end gap-3';
            div.innerHTML = `
                <div class="max-w-[85%] sm:max-w-[80%] bg-gradient-to-r from-orange-600 to-amber-600 rounded-2xl rounded-tr-sm p-4 text-xs sm:text-sm text-white shadow-lg shadow-orange-500/10">
                    <div class="text-[10px] text-orange-200/80 mb-1 font-semibold flex items-center justify-end gap-1">
                        <span>Quản Trị Viên</span>
                        <i class="fa-solid fa-user-shield text-[9px]"></i>
                    </div>
                    <div class="whitespace-pre-wrap leading-relaxed">${escapeHtml(text)}</div>
                </div>
                <div class="w-8 h-8 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-orange-400 text-xs font-bold shrink-0">
                    AG
                </div>
            `;
            chatMessages.appendChild(div);
            scrollToBottom();
        }

        function appendAiMessage(rawMarkdown) {
            const div = document.createElement('div');
            div.className = 'flex items-start gap-3';
            const parsedHtml = marked.parse(rawMarkdown);
            const msgId = 'msg-' + Date.now();

            div.innerHTML = `
                <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-orange-600 via-amber-500 to-amber-400 flex items-center justify-center text-white text-xs font-bold shrink-0 shadow-md shadow-orange-500/20">
                    <i class="fa-solid fa-brain"></i>
                </div>
                <div class="max-w-[85%] sm:max-w-[80%] bg-slate-900/90 border border-slate-800/90 rounded-2xl rounded-tl-sm p-4 text-xs sm:text-sm text-slate-200 shadow-md">
                    <div class="flex items-center justify-between mb-2 pb-1.5 border-b border-slate-800">
                        <span class="font-bold text-amber-400 flex items-center gap-1.5">
                            <i class="fa-solid fa-sparkles"></i>
                            SmartGym Executive Advisor
                        </span>
                        <button onclick="copyResponse('${msgId}')" class="text-[10px] text-slate-400 hover:text-white px-2 py-0.5 rounded bg-slate-800/60 hover:bg-slate-800 transition flex items-center gap-1" title="Sao chép câu trả lời">
                            <i class="fa-regular fa-copy"></i>
                            <span id="copy-text-${msgId}">Sao chép</span>
                        </button>
                    </div>
                    <div id="${msgId}" class="ai-prose space-y-2">
                        ${parsedHtml}
                    </div>
                </div>
            `;
            chatMessages.appendChild(div);
            scrollToBottom();
        }

        function appendLoadingIndicator() {
            const id = 'loading-' + Date.now();
            const div = document.createElement('div');
            div.id = id;
            div.className = 'flex items-start gap-3';
            div.innerHTML = `
                <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-orange-600 via-amber-500 to-amber-400 flex items-center justify-center text-white text-xs font-bold shrink-0 shadow-md shadow-orange-500/20 animate-pulse">
                    <i class="fa-solid fa-brain"></i>
                </div>
                <div class="bg-slate-900/90 border border-slate-800/90 rounded-2xl rounded-tl-sm p-4 text-xs text-slate-400 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                    <span>Đang trích xuất dữ liệu hệ thống & phân tích chiến lược...</span>
                </div>
            `;
            chatMessages.appendChild(div);
            scrollToBottom();
            return id;
        }

        function appendErrorMessage(message) {
            const div = document.createElement('div');
            div.className = 'flex items-start gap-3';
            div.innerHTML = `
                <div class="w-8 h-8 rounded-xl bg-red-500/20 text-red-400 flex items-center justify-center text-xs font-bold shrink-0 border border-red-500/30">
                    <i class="fa-solid fa-circle-exclamation"></i>
                </div>
                <div class="max-w-[85%] sm:max-w-[80%] bg-red-500/10 border border-red-500/30 rounded-2xl rounded-tl-sm p-4 text-xs sm:text-sm text-red-300">
                    <div class="font-bold text-red-400 mb-1">Thông báo hệ thống</div>
                    <div>${escapeHtml(message)}</div>
                </div>
            `;
            chatMessages.appendChild(div);
            scrollToBottom();
        }

        function removeElement(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        function scrollToBottom() {
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function clearConversation() {
            conversationHistory = [];
            chatMessages.innerHTML = '';
            // Tái tạo tin chào mừng
            const div = document.createElement('div');
            div.className = 'flex items-start gap-3';
            div.innerHTML = `
                <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-orange-600 via-amber-500 to-amber-400 flex items-center justify-center text-white text-xs font-bold shrink-0 shadow-md shadow-orange-500/20">
                    <i class="fa-solid fa-brain"></i>
                </div>
                <div class="max-w-[85%] sm:max-w-[80%] bg-slate-900/90 border border-slate-800/90 rounded-2xl rounded-tl-sm p-4 text-xs sm:text-sm text-slate-200 shadow-md">
                    <div class="flex items-center justify-between mb-2 pb-1.5 border-b border-slate-800">
                        <span class="font-bold text-amber-400 flex items-center gap-1.5">
                            <i class="fa-solid fa-sparkles"></i>
                            SmartGym Executive Advisor
                        </span>
                        <span class="text-[10px] text-emerald-400">Cuộc trò chuyện mới</span>
                    </div>
                    <div class="ai-prose space-y-2">
                        <p>Đã làm mới phiên trò chuyện. Tôi sẵn sàng giải đáp bất kỳ câu hỏi hoặc yêu cầu phân tích dữ liệu nào từ bạn!</p>
                    </div>
                </div>
            `;
            chatMessages.appendChild(div);
        }

        function copyResponse(id) {
            const el = document.getElementById(id);
            if (!el) return;
            const text = el.innerText;
            navigator.clipboard.writeText(text).then(() => {
                const label = document.getElementById('copy-text-' + id);
                if (label) {
                    label.textContent = 'Đã chép!';
                    setTimeout(() => { label.textContent = 'Sao chép'; }, 2000);
                }
            });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
</body>
</html>
